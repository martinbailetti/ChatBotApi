# ============================================================
# ChatBotApi — Variables de entorno
# ============================================================
# Copia este archivo como .env.{hostname} o .env y rellena
# los valores reales. NUNCA incluir este archivo con secretos
# reales en el repositorio.
# ============================================================

# ── Aplicación ────────────────────────────────────────────
APP_ENV=development
APP_TIMEZONE=Europe/Madrid

# ── CORS ─────────────────────────────────────────────────
# Orígenes permitidos separados por coma. Usar * solo en dev.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Base de datos ─────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chatbotapi
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ── Autenticación local ───────────────────────────────────
# AUTH_SECRET debe ser una cadena larga, aleatoria y distinta
# por entorno. Generar con: openssl rand -hex 64
# NUNCA usar este valor de ejemplo en producción.
AUTH_SECRET=CAMBIAR_POR_UN_VALOR_LARGO_ALEATORIO_EN_PRODUCCION
AUTH_TOKEN_TTL_SECONDS=28800


 DOCS_CHAT_URL=http://localhost:8888/consulta
 DOCS_BASE_URL=http://localhost:8888